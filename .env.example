# Copy to .env and fill in values locally. Never commit .env.
# Read by the application only; do not print credentials or tokens.
GOOGLE_CLIENT_SECRETS_FILE=/absolute/path/to/client_secret.json
GOOGLE_REFRESH_TOKEN=
SQLITE_PATH=data/health.sqlite3
EXPORT_DIR=data/exports
MCP_HOST=127.0.0.1
MCP_PORT=8767
CACHE_TTL_SECONDS=300
MCP_ALLOWED_HOSTS=127.0.0.1:*,localhost:*,[::1]:*
MCP_ALLOWED_ORIGINS=http://127.0.0.1:*,http://localhost:*
