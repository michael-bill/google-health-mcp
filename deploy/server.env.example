# Copy to /etc/google-health-mcp/server.env; replace the example domain.
AUTH_MODE=oauth
PUBLIC_BASE_URL=https://health.example.com
TOKEN_KEY_FILE=/etc/google-health-mcp/token-keys.json
GOOGLE_CLIENT_SECRETS_FILE=/etc/google-health-mcp/google-client.json
SQLITE_PATH=/var/lib/google-health-mcp/health.sqlite3
EXPORT_DIR=/var/lib/google-health-mcp/exports
MCP_HOST=127.0.0.1
MCP_PORT=8767
MCP_ALLOWED_HOSTS=health.example.com,localhost:*,127.0.0.1:*
MCP_ALLOWED_ORIGINS=https://health.example.com
